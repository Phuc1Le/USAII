DATABASE_URL=postgresql://postgres:123456@postgres:5432/usaii
USE_MOCK_AGENT=true
AGENT_URL=http://agent:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# optional — only needed for the agent's web_search tool (serpapi.com)
SERP_API_KEY=
# shared secret for the backend's /internal/* routes; the backend and the agent
# must carry the SAME value. Leave empty for local dev (routes stay open and the
# backend logs a warning); generate one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
# comma-separated browser origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
POSTGRES_PASSWORD=postgres
CHAT_HISTORY_LIMIT=20
CLARITY_THRESHOLD=0.7
CHAT_SUMMARY_TRIGGER=6
CHAT_SUMMARY_KEEP=3
CHAT_SUMMARY_RE_EVERY=2
